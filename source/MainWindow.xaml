<Window x:Class="Yuhui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="余晖" Width="304" Height="306" Topmost="True" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Loaded="Window_Loaded" MouseLeftButtonDown="Window_MouseLeftButtonDown" MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave">
  <Window.Resources>
    <LinearGradientBrush x:Key="CardBackground" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#F5FFFC" Offset="0"/><GradientStop Color="#EAF4EF" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="SoftButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#647A71"/><Setter Property="Padding" Value="7"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E1ECE5"/><Setter Property="Foreground" Value="#37594D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="RootCard" Margin="8" Padding="17,15,17,14" CornerRadius="20,0,0,20" Background="{StaticResource CardBackground}" BorderBrush="#D1DFD7" BorderThickness="1" SnapsToDevicePixels="True">
    <Border.Effect><DropShadowEffect BlurRadius="27" ShadowDepth="9" Direction="225" Opacity="0.28" Color="#294C40"/></Border.Effect>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="116"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Row="0"><TextBlock x:Name="CityText" Text="余晖 · 杭州" FontSize="11" FontWeight="Bold" Foreground="#668078"/><TextBlock x:Name="StageText" Text="黄金时刻" Margin="0,4,0,0" FontSize="23" FontWeight="SemiBold" Foreground="#1E3A31"/><TextBlock x:Name="WeatherText" Text="天空清朗，日落会很清晰" Margin="0,2,0,0" FontSize="10" Foreground="#6E8179"/></StackPanel>
      <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"><Button x:Name="LofiButton" Click="LofiButton_Click" PreviewMouseWheel="LofiButton_PreviewMouseWheel" Style="{StaticResource SoftButton}" ToolTip="播放 Lofi；滚轮切换频道">▶</Button><Button x:Name="SettingsButton" Click="SettingsButton_Click" Style="{StaticResource SoftButton}" ToolTip="设置">⋯</Button></StackPanel>
      <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,-2"><TextBlock x:Name="ClockText" Text="16:45" FontSize="30" FontWeight="SemiBold" Foreground="#223C33"/><TextBlock x:Name="RemainingText" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,7" Text="距日落 1小时27分" FontSize="15" FontWeight="SemiBold" Foreground="#A94D24"/></Grid>
      <Viewbox Grid.Row="2" Grid.ColumnSpan="2" Stretch="Fill" Height="116">
        <Canvas Width="270" Height="116">
          <Line X1="10" Y1="100" X2="260" Y2="100" Stroke="#94AAA0" StrokeThickness="1" Opacity=".42"/>
          <Path x:Name="ArcBase" Data="M 12,97 Q 135,-12 258,97" Stroke="#95A99F" StrokeThickness="2" Opacity=".53"/>
          <Path x:Name="ArcProgress" Data="M 12,97 Q 135,-12 258,97" Stroke="#E3914C" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          <Canvas x:Name="SunMarker" Width="30" Height="30"><Ellipse Canvas.Left="6" Canvas.Top="6" Width="18" Height="18" Fill="#FFC56A"><Ellipse.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#E99446" Opacity=".78"/></Ellipse.Effect></Ellipse><Line X1="15" Y1="0" X2="15" Y2="4" Stroke="#DE8E49" StrokeThickness="1.2"/><Line X1="27" Y1="5" X2="24" Y2="8" Stroke="#DE8E49" StrokeThickness="1.2"/><Line X1="3" Y1="5" X2="6" Y2="8" Stroke="#DE8E49" StrokeThickness="1.2"/></Canvas>
        </Canvas>
      </Viewbox>
      <Grid Grid.Row="3" Grid.ColumnSpan="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="日出" FontSize="10" Foreground="#748980"/><TextBlock x:Name="SunriseText" Text="06:03" FontSize="12" FontWeight="SemiBold" Foreground="#3F5C52"/></StackPanel><TextBlock x:Name="ProgressText" Grid.Column="1" Margin="12,11" Text="76%" FontSize="11" Foreground="#6C8077"/><StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="日落" HorizontalAlignment="Right" FontSize="10" Foreground="#748980"/><TextBlock x:Name="SunsetText" Text="18:12" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="#3F5C52"/></StackPanel></Grid>
      <Border x:Name="EdgeProgressRail" Grid.RowSpan="4" HorizontalAlignment="Right" VerticalAlignment="Center" Width="8" Height="92" CornerRadius="4" Background="#C2D1C8" Visibility="Collapsed" IsHitTestVisible="False"><Border x:Name="EdgeProgressFill" VerticalAlignment="Bottom" Height="54" CornerRadius="4" Background="#E98B49"/></Border>
      <Border x:Name="SettingsPanel" Grid.RowSpan="4" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#F7FCF8" CornerRadius="12" Padding="15">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><DockPanel><TextBlock Text="余晖设置" FontSize="16" FontWeight="SemiBold" Foreground="#254338"/><Button DockPanel.Dock="Right" Click="CloseSettings_Click" Style="{StaticResource SoftButton}" Padding="4" ToolTip="关闭">×</Button></DockPanel><DockPanel Margin="0,10,0,0"><Button DockPanel.Dock="Left" Click="ChooseLocalAudio_Click" Style="{StaticResource SoftButton}" Padding="7,5" Background="#E5F0E9">选择本地</Button><ComboBox x:Name="ChannelSelector" Width="142" Margin="8,0,0,0" Padding="5,3" SelectionChanged="ChannelSelector_SelectionChanged"><ComboBoxItem Tag="online" Content="在线 · lofi.cafe"/><ComboBoxItem Tag="local" Content="本地文件"/><ComboBoxItem Tag="chillhop" Content="Chillhop" IsSelected="True"/><ComboBoxItem Tag="late-night" Content="Late night vibes"/><ComboBoxItem Tag="hip-hop" Content="Hip hop radio"/><ComboBoxItem Tag="relaxing" Content="Relaxing beats"/><ComboBoxItem Tag="coffee-shop" Content="Coffee shop radio"/><ComboBoxItem Tag="videogame" Content="Videogame lofi &amp; chill"/><ComboBoxItem Tag="space" Content="Space ambient music"/><ComboBoxItem Tag="sleepy" Content="Sad &amp; sleepy"/><ComboBoxItem Tag="synthwave" Content="Lofi synthwave"/></ComboBox></DockPanel><CheckBox x:Name="AutoLocationCheck" Margin="0,12,0,0" Content="自动获取位置与天气" IsChecked="True" Checked="AutoLocationCheck_Changed" Unchecked="AutoLocationCheck_Changed" FontSize="12" Foreground="#3D5B50"/><TextBlock x:Name="LocationHintText" Margin="0,3,0,3" Text="联网后会用当前位置计算日落。" TextWrapping="Wrap" FontSize="10" Foreground="#73877E"/><TextBlock Margin="0,6,0,6" Text="手动位置" FontSize="11" Foreground="#61786E"/><ComboBox x:Name="CitySelector" SelectionChanged="CitySelector_SelectionChanged" SelectedIndex="0" Padding="7,5"><ComboBoxItem Content="杭州"/><ComboBoxItem Content="上海"/><ComboBoxItem Content="北京"/><ComboBoxItem Content="成都"/></ComboBox><CheckBox x:Name="StartupCheck" Margin="0,12,0,0" Content="开机时启动余晖" Checked="StartupCheck_Changed" Unchecked="StartupCheck_Changed" FontSize="12" Foreground="#3D5B50"/><CheckBox x:Name="TopmostCheck" Margin="0,7,0,0" Content="始终置顶" IsChecked="True" Checked="TopmostCheck_Changed" Unchecked="TopmostCheck_Changed" FontSize="12" Foreground="#3D5B50"/><CheckBox x:Name="AutoHideCheck" Margin="0,7,0,0" Content="贴右边自动收纳" Checked="AutoHideCheck_Changed" Unchecked="AutoHideCheck_Changed" FontSize="12" Foreground="#3D5B50"/><CheckBox x:Name="HourlyPeekCheck" Margin="0,7,0,0" Content="整点自动滑出再收入" IsChecked="True" Checked="HourlyPeekCheck_Changed" Unchecked="HourlyPeekCheck_Changed" FontSize="12" Foreground="#3D5B50"/><CheckBox x:Name="MouseThroughCheck" Margin="0,7,0,0" Content="鼠标穿透（不拦截桌面操作）" Checked="MouseThroughCheck_Changed" Unchecked="MouseThroughCheck_Changed" FontSize="12" Foreground="#3D5B50"/><DockPanel Margin="0,11,0,0"><TextBlock Text="不透明度" FontSize="12" Foreground="#3D5B50"/><TextBlock x:Name="OpacityValueText" DockPanel.Dock="Right" Text="92%" FontSize="12" Foreground="#6A7F76"/></DockPanel><Slider x:Name="OpacitySlider" Minimum="35" Maximum="100" Value="92" Margin="0,5,0,0" ValueChanged="OpacitySlider_ValueChanged"/><TextBlock Margin="0,10,0,0" Text="内置频道为运行时生成的原创循环；收纳后右侧仍会保留日落进度。" TextWrapping="Wrap" FontSize="10" Foreground="#73877E"/></StackPanel></ScrollViewer>
      </Border>
    </Grid>
  </Border>
</Window>
